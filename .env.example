# Pick exactly one Detective backend (or leave all blank to use the deterministic mock).
DECEPTENV_DETECTIVE=mock          # mock | openai | anthropic | hf_inference | local_hf
DECEPTENV_DETECTIVE_MODEL=         # provider-specific model id

# Provider credentials (only needed for the matching backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Server
DECEPTENV_HOST=0.0.0.0
DECEPTENV_PORT=7860
DECEPTENV_MAX_TURNS=10
DECEPTENV_SEED=

# Client
DECEPTENV_BASE_URL=http://localhost:7860
